source("/media/razheer/HD/0_digital_life/professional/data_science/ufmg/disciplinas/ar_analise_de_regressao/tp/dados/testes_sergio.R", echo = TRUE)
res_estudentizados <- rstudent(fit_full)
outliers_pontuais <- which(abs(res_estudentizados > 3))
outliers_pontuais
res_estudentizados <- rstudent(fit_full)
outliers_pontuais <- which(abs(res_estudentizados > 3))
res_estudentizados <- rstudent(fit_full)
car::outlierTest(fit_full)
abline(0, 1, col = "red", lwd = 2)
# Número de observações (n) e de parâmetros (p)
n <- nrow(casas_train)
p <- length(coef(modelo_forward)) - 1 # desconta o intercepto
graus_liberdade <- n - p - 1
# Gráfico Q-Q comparando os resíduos estudentizados com a t-Student teórica
qqplot(qt(ppoints(n), df = graus_liberdade), res_estudentizados,
main = "Q-Q Plot: Resíduos vs t-Student",
xlab = "Quantis teóricos (t-Student)",
ylab = "Resíduos Estudentizados")
abline(0, 1, col = "red", lwd = 2)
