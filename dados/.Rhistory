#| echo: true
set.seed(64)
divisao <- initial_split(dados, prop = 0.8)
treino <- training(divisao)
teste  <- testing(divisao)
lm_model <- linear_reg() |>
set_engine("lm")
lm_wflow <- workflow() |>
add_model(lm_model) |>
add_formula(preco ~ .)
# Ajuste e avaliação
lm_fit <- fit(lm_wflow, data = treino)
#| echo: true
fit1 <- extract_fit_engine(lm_fit)
anova(fit1)
ggresiduals(fit1)
#| echo: true
log_wflow <- workflow() |>
add_model(lm_model) |>
add_formula(log(preco) ~ .)
lmlog_fit <- fit(log_wflow, data = treino)
fit2 <- extract_fit_engine(lmlog_fit, data = treino)
anova(fit2)
ggresiduals(fit2)
