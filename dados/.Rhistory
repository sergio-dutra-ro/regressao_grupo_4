library(tidyverse)
library(tidymodels)
library(reglin)
library(car)
casas <- read.csv("casas.csv")
glimpse(casas)
casas <- casas |>
mutate(across(where(is.character), as.factor))
sapply(casas, class)
fit1 <- lm(preco ~ . , data = casas)
ggresiduals("fit1")
ggresiduals(fit1)
ggresiduals(log(fit1))
fit1 <- lm(log(preco) ~ . , data = casas)
ggresiduals(fit1)
fit2 <- update(fit1, . ~ . + quartos:banheiro)
fit2 <- update(fit1, . ~ . + quartos:banheiros)
ggresiduals(fit2)
anova(fit2)
anova(fit1, fit2)
fit2 <- update(fit1, . ~ . + area:banheiros)
anova(fit1, fit2)
ggresiduals(fit2)
fit2 <- update(fit1, . ~ . + area:banheiros)
fit2 <- update(fit1, . ~ . + area_lote:banheiros)
ggresiduals(fit2)
anova(fit1, fit2)
fit <-lm(preco ~ . - area_lote, data = casas)
glimpse(fite)
glimpse(fit)
ggresiduals(fit)
fitl <-lm(log(preco) ~ . - area_lote, data = casas)
ggresiduals(fitl)
ggresiduals(fit1)
fit <-lm(preco ~ . - area_lote, data = casas)
ggresiduals(fit)
ggresiduals(fitl)
